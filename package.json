{
  "name": "zero-buddy-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev -p 3040",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "cross-env PLAYWRIGHT_SLOWMO=800 playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:mock": "cross-env CI=true playwright test",
    "test:e2e:mock:headed": "cross-env CI=true PLAYWRIGHT_SLOWMO=800 playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "next": "^15.5.22",
    "react": "^19.3.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "cross-env": "^10.1.0",
    "eslint": "8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-next": "15.5.22",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "prettier": "3.3.3",
    "typescript": "5.5.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
